# Type stubs for bpak._bpak, the C extension of the bpak package

import uuid
from collections.abc import Callable
from os import PathLike
from typing import ClassVar, TypeAlias, final

from typing_extensions import Self, disjoint_base

_Path: TypeAlias = str | bytes | PathLike[str] | PathLike[bytes]

HASH_SHA256: int
HASH_SHA384: int
HASH_SHA512: int

SIGN_RSA4096: int
SIGN_PRIME256v1: int
SIGN_SECP384r1: int
SIGN_SECP521r1: int

KEY_PUB_RSA4096: int
KEY_PUB_PRIME256v1: int
KEY_PUB_SECP384r1: int
KEY_PUB_SECP521r1: int

FLAG_EXCLUDE_FROM_HASH: int
FLAG_TRANSPORT: int

METADATA_BYTES: int
SIGNATURE_MAX_BYTES: int

class Error(Exception):
    code: ClassVar[int]

class FailedError(Error): ...
class NotFoundError(Error): ...
class SizeError(Error): ...
class NoSpaceLeftError(Error): ...
class BadAlignmentError(Error): ...
class SeekError(Error): ...
class NotSupportedError(Error): ...
class NeedsMoreDataError(Error): ...
class WriteError(Error): ...
class DecompressorError(Error): ...
class CompressorError(Error): ...
class PatchReadOriginError(Error): ...
class PatchWriteError(Error): ...
class ReadError(Error): ...
class BadMagicError(Error): ...
class UnsupportedHashAlgError(Error): ...
class BufferTooSmallError(Error): ...
class FileNotFoundError(Error): ...  # noqa: A001
class KeyDecodeError(Error): ...
class VerifyFailError(Error): ...
class SignFailError(Error): ...
class UnsupportedKeyError(Error): ...
class BadRootHashError(Error): ...
class BadPayloadHashError(Error): ...
class MissingMetaDataError(Error): ...
class PackageUuidMismatchError(Error): ...
class UnsupportedCompressionError(Error): ...
class KeyNotFoundError(Error): ...
class KeystoreIdMismatchError(Error): ...
class ExistsError(Error): ...

@final
class Part:
    @property
    def id(self) -> int: ...
    @property
    # Size in the package, with padding, or the transport size if encoded.
    def size(self) -> int: ...
    @property
    # Size of the part data when it is installed, without padding.
    def installed_size(self) -> int: ...
    @property
    def transport_size(self) -> int: ...
    @property
    def pad_bytes(self) -> int: ...
    @property
    def flags(self) -> int: ...
    @property
    # Offset of the part data in the file.
    def offset(self) -> int: ...
    @property
    def is_transport_encoded(self) -> bool: ...
    def read_data(self) -> bytes: ...
    def delete(self, remove_meta: bool = True) -> None: ...

@final
class Meta:
    @property
    def id(self) -> int: ...
    @property
    def part_id_ref(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def raw_data(self) -> bytes: ...
    @raw_data.setter
    # Strings are stored with a terminating NUL.
    def raw_data(self, value: bytes | str) -> None: ...
    def as_uuid(self) -> uuid.UUID: ...
    def as_string(self) -> str: ...
    def describe(self) -> str: ...
    def delete(self) -> None: ...

@disjoint_base
class Package:
    hash_kind: int
    signature_kind: int
    key_id: int
    keystore_id: int
    def __init__(self, filename: _Path, mode: str) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...
    def close(self) -> None: ...
    def verify(
        self, verify_key_path: _Path | None = None, *, keystore_path: _Path | None = None
    ) -> bool: ...
    def sign(self, sign_key_path: _Path) -> bool: ...
    def add_file(
        self, part_name: str, filename: _Path, with_merkle_tree: bool = False, flags: int = 0
    ) -> Part: ...
    def add_key(self, part_name: str, filename: _Path, flags: int = 0) -> Part: ...
    def add_meta(
        self,
        id: int,  # noqa: A002
        part_id_ref: int = 0,
        data: bytes | str | None = None,
        size: int = -1,
    ) -> Meta: ...
    def get_part(self, id: int) -> Part: ...  # noqa: A002
    def get_meta(self, id: int, part_id_ref: int = 0) -> Meta: ...  # noqa: A002
    # Compute the payload hash and return the header hash.
    def update_hash(self) -> bytes: ...
    def write_header(self) -> None: ...
    def add_transport_meta(self, part_id: int, encoder_id: int, decoder_id: int) -> None: ...
    def delete_part(self, id: int, remove_meta: bool = True) -> None: ...  # noqa: A002
    def delete_all_parts(self, remove_meta: bool = True) -> None: ...
    def part_sha256(self, id: int) -> bytes: ...  # noqa: A002
    def extract_file(self, id: int, filename: _Path) -> None: ...  # noqa: A002
    @property
    def digest(self) -> bytes | None: ...
    @property
    def payload_hash(self) -> bytes: ...
    @property
    def signature(self) -> bytes: ...
    @signature.setter
    def signature(self, value: bytes | None) -> None: ...
    @property
    def size(self) -> int: ...
    @property
    def installed_size(self) -> int: ...
    @property
    def parts(self) -> list[Part]: ...
    @property
    def meta(self) -> list[Meta]: ...

def id(string: str) -> int: ...  # noqa: A001
def id_to_string(id: int) -> str: ...  # noqa: A002
def hash_kind_to_string(kind: int) -> str: ...
def signature_kind_to_string(kind: int) -> str: ...

# Parse a DER encoded public key, returns its KEY_ kind and DER data.
def parse_public_key(data: bytes) -> tuple[int, bytes]: ...
def set_log_func(log_func: Callable[[int, str], object] | None) -> None: ...
def transport_encode(
    input: Package,  # noqa: A002
    output: Package,
    origin: Package | None = None,
) -> None: ...
def transport_decode(
    input: Package,  # noqa: A002
    output: Package,
    origin: Package | None = None,
) -> None: ...
def version() -> str: ...
